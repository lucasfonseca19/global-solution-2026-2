                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Total 5.5 sem duplicar', () => pm.expect(j.totalKg).to.eql(5.5));",
                  "pm.test('Alerta de limite', () => pm.expect(j.alerta.tipo).to.eql('DESCARTE_ACIMA_DO_LIMITE'));"
                ]
              }
            }
          ]
