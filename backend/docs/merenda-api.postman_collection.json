{
  "info": {
    "name": "Merenda API - Global Solution 2026/2",
    "description": "Todos os endpoints da API. Rode primeiro '1. Login' (salva o token automaticamente). Depois rode a pasta inteira com o Collection Runner para ver os cenários do contrato.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "1. Login (operador / merenda123)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"operador\",\n  \"senha\": \"merenda123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.test('Recebeu token', () => pm.expect(j.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login com senha errada (401)",
          "request": {
