              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('servicoId', j.id);",
                  "pm.test('Pendente com total parcial 3 kg', () => { pm.expect(j.status).to.eql('PENDENTE'); pm.expect(j.totalKg).to.eql(3); pm.expect(j.pesagens.RESTO_PRATO).to.eql(null); });"
                ]
              }
            }
          ]
        },
