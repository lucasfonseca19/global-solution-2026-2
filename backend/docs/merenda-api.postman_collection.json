              "raw": "{\n  \"data\": \"2026-11-13\",\n  \"tipoRefeicao\": \"Almoço\",\n  \"pesagens\": [\n    {\n      \"codigoRfid\": \"RFID-SIM-001\",\n      \"pesoBrutoKg\": 4\n    }\n  ]\n}"
            },
            "auth": {
              "type": "bearer",
