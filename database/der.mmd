erDiagram
    USUARIO ||--o{ SERVICO_ALIMENTACAO : "registra"
    SERVICO_ALIMENTACAO ||--o{ PESAGEM : "soma contribuições"
    CATEGORIA_DESCARTE ||--o{ LIXEIRA : "classifica"
    LIXEIRA ||--o{ PESAGEM : "é pesada em"
    CATEGORIA_DESCARTE ||--o{ PESAGEM : "define"

    SERVICO_ALIMENTACAO |o--o{ CICLO_PESAGEM : "deduplica"

    CICLO_PESAGEM {
        varchar ciclo_id PK
        varchar payload_hash "SHA-256 canônico"
        bigint servico_id FK "nullable; ON DELETE SET NULL"
    }

    USUARIO {
        bigint id PK
        varchar nome
        varchar login UK
        varchar senha_hash "BCrypt"
        timestamp criado_em
    }
    CATEGORIA_DESCARTE {
        bigint id PK
        varchar codigo UK "SOBRA_DESCARTADA / RESTO_PRATO"
        varchar descricao
    }
    LIXEIRA {
        bigint id PK
        varchar codigo_rfid UK
        varchar descricao
        bigint categoria_id FK
        numeric tara_kg
    }
    SERVICO_ALIMENTACAO {
        bigint id PK
        date data_servico UK "UK(data, tipo)"
        varchar tipo_refeicao UK
        bigint usuario_id FK
        timestamp criado_em
        timestamp atualizado_em
        timestamptz concluido_em "NULL = pendente"
    }
    PESAGEM {
        bigint id PK
        bigint servico_id FK "ON DELETE CASCADE"
        bigint lixeira_id FK
        bigint categoria_id FK
        numeric peso_bruto_kg
        numeric tara_kg
        numeric peso_liquido_kg
        timestamp confirmado_em
    }
